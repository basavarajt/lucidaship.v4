### Error Handling Strategy

```python
async def call_resend_with_retry(endpoint: str, method: str, payload: dict, retries: int = 3):
    """Robust Resend API wrapper with retry logic"""
    
    for attempt in range(retries):
        try:
            async with httpx.AsyncClient(timeout=10.0) as client:
                if method == "POST":
                    resp = await client.post(
                        f"https://api.resend.com{endpoint}",
                        json=payload,
                        headers={"Authorization": f"Bearer {RESEND_KEY}"}
                    )
                elif method == "GET":
                    resp = await client.get(
                        f"https://api.resend.com{endpoint}",
                        headers={"Authorization": f"Bearer {RESEND_KEY}"}
                    )
                
                if resp.status_code == 429:  # Rate limited
                    await asyncio.sleep(2 ** attempt)  # Exponential backoff
                    continue
                
                if resp.status_code >= 500:  # Server error
                    await asyncio.sleep(1)
                    continue
                
                if resp.status_code < 400:
                    return resp.json()
                
                raise HTTPException(
                    status_code=resp.status_code,
                    detail=resp.json().get("message", "API error")
                )
        
        except httpx.TimeoutException:
            if attempt == retries - 1:
                raise HTTPException(status_code=504, detail="Resend API timeout")
            await asyncio.sleep(1)
    
    raise HTTPException(status_code=503, detail="Resend API unavailable")
```

