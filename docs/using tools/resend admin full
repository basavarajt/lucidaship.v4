### Webhook Handling in Your Backend

```python
# backend/api/webhooks/resend.py
from fastapi import APIRouter, Request
from resend import Resend
import hmac
import hashlib
import json

router = APIRouter(prefix="/api/webhooks", tags=["webhooks"])

@router.post("/resend")
async def handle_resend_webhook(request: Request):
    """
    Handle all Resend webhook events:
    - Email opened/clicked
    - Email bounced/complained
    - Contact subscribed/unsubscribed
    - Broadcast sent/opened/clicked
    """
    
    body = await request.body()
    signature = request.headers.get("x-resend-signature")
    
    # Verify webhook signature
    expected_sig = hmac.new(
        os.getenv("RESEND_WEBHOOK_SECRET").encode(),
        body,
        hashlib.sha256
    ).hexdigest()
    
    if not hmac.compare_digest(signature, expected_sig):
        return {"error": "Invalid signature"}, 401
    
    event = json.loads(body)
    event_type = event["type"]
    data = event["data"]
    
    # Handle each event type
    if event_type == "email.opened":
        # Track in your database
        db.email_analytics.insert_one({
            "email_id": data["email_id"],
            "event": "opened",
            "timestamp": datetime.now()
        })
        print(f"Email {data['email_id']} was opened")
    
    elif event_type == "email.clicked":
        db.email_analytics.insert_one({
            "email_id": data["email_id"],
            "event": "clicked",
            "url": data["url"],
            "timestamp": datetime.now()
        })
        print(f"Link clicked in {data['email_id']}: {data['url']}")
    
    elif event_type == "email.bounced":
        # Unsubscribe or flag for review
        db.contacts.update_one(
            {"email": data["email"]},
            {"$set": {"status": "bounced", "bounce_reason": data["reason"]}}
        )
        print(f"Email {data['email']} bounced: {data['reason']}")
    
    elif event_type == "email.complained":
        # Mark as spam complaint
        db.contacts.update_one(
            {"email": data["email"]},
            {"$set": {"status": "complained"}}
        )
        print(f"Spam complaint from {data['email']}")
    
    elif event_type == "email.unsubscribed":
        # Respect unsubscribe
        db.contacts.update_one(
            {"email": data["email"]},
            {"$set": {"unsubscribed": True}}
        )
        print(f"{data['email']} unsubscribed")
    
    elif event_type == "broadcast.opened":
        db.broadcast_analytics.insert_one({
            "broadcast_id": data["broadcast_id"],
            "email": data["email"],
            "event": "opened",
            "timestamp": datetime.now()
        })
    
    # Always return 200 to acknowledge receipt
    return {"received": True}
```

