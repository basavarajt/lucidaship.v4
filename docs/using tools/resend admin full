```tsx
// components/admin/ContactManager.tsx
import { useState, useEffect } from 'react';

export default function ContactManager() {
  const [contacts, setContacts] = useState([]);
  const [search, setSearch] = useState('');
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    fetchContacts();
  }, []);

  const fetchContacts = async () => {
    setLoading(true);
    const res = await fetch('/api/admin/contacts', {
      headers: { 'Authorization': `Bearer ${adminToken}` }
    });
    setContacts(await res.json());
    setLoading(false);
  };

  const addContact = async (email, firstName, lastName, properties) => {
    const res = await fetch('/api/admin/contacts/create', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${adminToken}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        email,
        first_name: firstName,
        last_name: lastName,
        ...properties
      })
    });
    const contact = await res.json();
    setContacts([...contacts, contact]);
  };

  const updateContact = async (id, updates) => {
    const res = await fetch(`/api/admin/contacts/${id}`, {
      method: 'PUT',
      headers: { 'Authorization': `Bearer ${adminToken}` },
      body: JSON.stringify(updates)
    });
    const updated = await res.json();
    setContacts(contacts.map(c => c.id === id ? updated : c));
  };

  const removeContact = async (id) => {
    await fetch(`/api/admin/contacts/${id}`, {
      method: 'DELETE',
      headers: { 'Authorization': `Bearer ${adminToken}` }
    });
    setContacts(contacts.filter(c => c.id !== id));
  };

  return (
    <div className="contact-manager">
      <h2>Contacts ({contacts.length})</h2>
      
      <div className="search-bar">
        <input
          type="text"
          placeholder="Search by email..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
        />
      </div>

      <button onClick={() => addContact(prompt('Email?'), ...)}>
        + Add Contact
      </button>

      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th>Name</th>
            <th>Status</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {contacts
            .filter(c => c.email.includes(search))
            .map(contact => (
              <tr key={contact.id}>
                <td>{contact.email}</td>
                <td>{contact.first_name} {contact.last_name}</td>
                <td>
                  <span className={contact.unsubscribed ? 'red' : 'green'}>
                    {contact.unsubscribed ? 'Unsubscribed' : 'Active'}
                  </span>
                </td>
                <td>{new Date(contact.created_at).toLocaleDateString()}</td>
                <td>
                  <button onClick={() => updateContact(contact.id, { unsubscribed: !contact.unsubscribed })}>
                    {contact.unsubscribed ? 'Resubscribe' : 'Unsubscribe'}
                  </button>
                  <button onClick={() => removeContact(contact.id)}>Delete</button>
                </td>
              </tr>
            ))}
        </tbody>
      </table>
    </div>
  );
}
```

