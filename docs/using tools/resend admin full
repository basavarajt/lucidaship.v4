**FastAPI Backend:**

```python
# backend/api/campaigns/broadcast.py
@router.post("/api/admin/campaigns/create")
async def create_campaign(
    name: str,
    audience_id: str,
    subject: str,
    html: str,
    scheduled_at: datetime = None,
    admin_key: str = Header(...)
):
    """Create a broadcast via Resend"""
    
    if admin_key != os.getenv("ADMIN_SECRET_KEY"):
        raise HTTPException(status_code=401)
    
    payload = {
        "audience_id": audience_id,
        "name": name,
        "subject": subject,
        "html": html,
        "from": os.getenv("SENDER_DOMAIN"),
        "track_opens": True,
        "track_clicks": True
    }
    
    if scheduled_at:
        payload["scheduled_at"] = scheduled_at.isoformat()
    
    async with httpx.AsyncClient() as client:
        resp = await client.post(
            "https://api.resend.com/broadcasts",
            json=payload,
            headers={"Authorization": f"Bearer {RESEND_KEY}"}
        )
    
    if resp.status_code != 200:
        raise HTTPException(status_code=resp.status_code, detail=resp.json())
    
    broadcast = resp.json()
    
    # Store broadcast in your database
    db.campaigns.insert_one({
        "resend_id": broadcast["id"],
        "name": name,
        "status": "draft",
        "audience_id": audience_id,
        "created_by": admin_key,
        "created_at": datetime.now()
    })
    
    return broadcast


@router.post("/api/admin/campaigns/{campaign_id}/send")
async def send_campaign(campaign_id: str, admin_key: str = Header(...)):
    """Send a broadcast campaign"""
    
    if admin_key != os.getenv("ADMIN_SECRET_KEY"):
        raise HTTPException(status_code=401)
    
    campaign = db.campaigns.find_one({"_id": campaign_id})
    resend_id = campaign["resend_id"]
    
    async with httpx.AsyncClient() as client:
        resp = await client.post(
            f"https://api.resend.com/broadcasts/{resend_id}/send",
            json={},
            headers={"Authorization": f"Bearer {RESEND_KEY}"}
        )
    
    if resp.status_code != 200:
        raise HTTPException(status_code=resp.status_code, detail=resp.json())
    
    # Update status
    db.campaigns.update_one(
        {"_id": campaign_id},
        {"$set": {"status": "sending", "sent_at": datetime.now()}}
    )
    
    return {"success": True, "status": "sending"}


@router.get("/api/admin/campaigns/{campaign_id}/stats")
async def get_campaign_stats(campaign_id: str, admin_key: str = Header(...)):
    """Get campaign engagement analytics"""
    
    if admin_key != os.getenv("ADMIN_SECRET_KEY"):
        raise HTTPException(status_code=401)
    
    campaign = db.campaigns.find_one({"_id": campaign_id})
    resend_id = campaign["resend_id"]
    
    async with httpx.AsyncClient() as client:
        resp = await client.get(
            f"https://api.resend.com/broadcasts/{resend_id}",
            headers={"Authorization": f"Bearer {RESEND_KEY}"}
        )
    
    if resp.status_code != 200:
        raise HTTPException(status_code=resp.status_code)
    
    stats = resp.json()
    return {
        "name": stats["name"],
        "status": stats["status"],
        "recipients": stats["recipients"],
        "delivered": stats["delivered"],
        "opened": stats["opened"],
        "open_rate": f"{(stats['opened']/stats['recipients']*100):.1f}%",
        "clicked": stats["clicked"],
        "click_rate": f"{(stats['clicked']/stats['recipients']*100):.1f}%",
        "bounced": stats["bounced"],
        "unsubscribed": stats["unsubscribed"],
        "sent_at": stats.get("sent_at")
    }
```

