# Local Development
VITE_API_URL=http://localhost:8000

# Production (Google Cloud Run)
# After deploying the backend to Cloud Run, replace VITE_API_URL with your Cloud Run service URL.
# VITE_API_URL=https://your-cloud-run-service-xyz.run.app

VITE_ENVIRONMENT=development

# Firebase web app configuration.
# These values are required for production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_MASTER_KEY=change-me
