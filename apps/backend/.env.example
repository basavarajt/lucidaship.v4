# Lucida Backend - Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to source control.

# Production / Persistent DB
# For production, set `DATABASE_URL` to a managed SQL database (Postgres, Cloud SQL, etc.).
# Leave `DATABASE_URL` blank for local SQLite development.
# Set true only for temporary non-persistent testing.
ALLOW_PRODUCTION_SQLITE_FALLBACK=false

# Optional SQLAlchemy connection string for PostgreSQL or another relational DB.
# Example: postgresql+psycopg://user:password@localhost:5432/lucida
DATABASE_URL=

# Local SQLite fallback path for development.
SQLITE_DB_PATH=./.local/lucida_local.db

# Firebase Auth
# Cloud Run should normally use Application Default Credentials from its service account.
# For local development, set this to a Firebase service account JSON file if you want
# to verify real Firebase ID tokens instead of using the local dev auth bypass.
GOOGLE_APPLICATION_CREDENTIALS=

# Application
# Set to "production" for Cloud Run.
ENVIRONMENT=development

# Admin-secret legacy endpoints. Required in production and must be a strong random value.
FASTAPI_SECRET_KEY=

# Comma-separated allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://lucidaanalytics.tech
ALLOW_GUEST_ACCESS=false

# Directory where trained .joblib model files are stored when GCS is not configured.
MODEL_ARTIFACTS_DIR=./model_artifacts

# Google Cloud Storage (serverless model hosting)
# The Cloud Run service account needs write/read access to this bucket.
GCS_BUCKET_NAME=

# Maximum accepted CSV upload size in megabytes.
MAX_CSV_SIZE_MB=200

# Upload-time numeric compression.
UPLOAD_COMPRESSION_ENABLED=true
UPLOAD_COMPRESSION_MODE=shadow
UPLOAD_COMPRESSION_NUMERIC_ONLY=true
UPLOAD_COMPRESSION_MIN_ROWS=128
UPLOAD_COMPRESSION_MAX_ALLOWED_MSE=0.05
UPLOAD_COMPRESSION_MAX_ALLOWED_IP_ERROR=0.10

# Ranking explanation intelligence layer.
# For local Ollama, make sure `ollama serve` is running and the model is available.
LLM_EXPLANATIONS_ENABLED=true
LLM_EXPLANATION_PROVIDER=ollama
LLM_EXPLANATION_MODEL=phi3:mini
LLM_EXPLANATION_ENDPOINT=http://localhost:11434/api/generate
LLM_EXPLANATION_TIMEOUT_SECONDS=8
LLM_EXPLANATION_MAX_ROWS=25

# Scoring performance and business-aware weighting.
SCORE_CACHE_TTL_SECONDS=300
SIGNAL_CACHE_TTL_SECONDS=600
BUSINESS_WEIGHT_JOB_TITLE=1.35
BUSINESS_WEIGHT_COMPANY_SIZE=1.2
BUSINESS_WEIGHT_RECENT_ACTIVITY=1.4
ADAPTIVE_WEIGHT_MIN=0.75
ADAPTIVE_WEIGHT_MAX=2.0
